<Window x:Class="AdaptHER.UI.Views.ForHRSpecialistWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdaptHER.UI.Views" Title="Adapter - Home"
        mc:Ignorable="d" Name="home" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True"
        ResizeMode="NoResize" FontFamily="Montserrat">
    <Border Background="{DynamicResource LightGreenColor}" CornerRadius="7" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="7" Margin="15" Background="{DynamicResource WhiteColor}" >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Border Margin="14 0 0 0" Width="40" Height="40" HorizontalAlignment="Left">
                            <Border.Background>
                                <ImageBrush ImageSource="/AdaptHER;component/Resources/LogoWnd.png" Stretch="Uniform"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Margin="60 0 0 0" FontSize="16" VerticalAlignment="Center">Adapter</TextBlock>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Margin="15 15 0 15" Width="30" Height="30" HorizontalAlignment="Left" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/AdaptHER;component/Resources/MenuAdaptModules.png" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                            <Border Margin="15 0 0 15" Width="30" Height="30" HorizontalAlignment="Left" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/AdaptHER;component/Resources/MenuAdaptPrograms.png" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                            <Border Margin="15 0 0 15" Width="30" Height="30" HorizontalAlignment="Left" CornerRadius="5">
                                <Border.Background>
                                    <ImageBrush ImageSource="/AdaptHER;component/Resources/MenuEventAnalysis.png" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition/>
                                <RowDefinition Height="75"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" x:Name="btnAdaptModules" Style="{DynamicResource NavButtonStyle}" Content="Adaptation Modules" Click="btnAdaptModules_Click"/>
                            <Button Grid.Row="1" x:Name="btnConstructor" Style="{DynamicResource NavButtonStyle}" Content="Adaptation Programs" Click="btnConstructor_Click"/>
                            <Button Grid.Row="2" x:Name="btnEventsAnalysis" Style="{DynamicResource NavButtonStyle}" Content="Event Analysis" Click="btnEventsAnalysis_Click"/>
                            <Button Grid.Row="4" x:Name="btnGoBack" Style="{DynamicResource NavButtonStyle}" Content="Exit" Click="btnGoBack_Click"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource WhiteColor}" CornerRadius="7" Margin="0 15">
                        <TextBlock VerticalAlignment="Center" Padding=" 20 0">Employee Adaptation Management Application of IT-Company STR</TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.RowSpan="2">
                        <Button x:Name="CloseBtn" Style="{DynamicResource NavViewButtonsStyle}" Content="x" Click="CloseBtn_Click" Tag="IsCloseButton"/>
                        <Button x:Name="RestoreBtn" Style="{DynamicResource NavViewButtonsStyle}" Content="o" Click="RestoreBtn_Click" Margin="10,0" />
                        <Button x:Name="MinimizeBtn" Style="{DynamicResource NavViewButtonsStyle}" Content="-" Click="MinimizeBtn_Click"/>
                    </StackPanel>
                </Grid>
                <Frame Grid.Row="1" x:Name="MainFrm" Margin="0 0 15 15" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</Window>