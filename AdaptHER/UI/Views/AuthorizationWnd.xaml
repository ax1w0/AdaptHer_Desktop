<Window x:Class="AdaptHER.UI.Views.AuthorizationWnd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdaptHER.UI.Views"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        MinHeight="565" MinWidth="500" MaxHeight="565" MaxWidth="500"
        WindowStyle="None" Title="Adapter - Authorization"
        Background="Transparent" AllowsTransparency="True"
        ResizeMode="NoResize">
    <Border Background="{DynamicResource LightGreenColor}" CornerRadius="7" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource WhiteColor}" CornerRadius="7" Margin="15 15 0 15">
                    <TextBlock VerticalAlignment="Center" Padding="15 0">Adapter IT-Company STR Application</TextBlock>
                </Border>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0" Orientation="Horizontal" FlowDirection="RightToLeft" Grid.RowSpan="2">
                    <Button x:Name="CloseBtn" Style="{DynamicResource NavViewButtonsStyle}" Content="x" Click="CloseBtn_Click" Tag="IsCloseButton"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" CornerRadius="10" Background="White" Padding="15 15 15 0" Margin="15 0 15 15">
                <StackPanel>
                    <TextBlock Text="Login" FontSize="22" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 15" />

                    <TextBlock Text="Enter username:" FontSize="14" Foreground="Black" Margin="0 0 0 5" />
                    <TextBox x:Name="TxtLogin" Height="25" Width="440" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Enter password:" FontSize="14" Foreground="Black" Margin="0 5 0 5" />
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtPassword" Height="25" Width="405" VerticalContentAlignment="Center" HorizontalAlignment="Left" Visibility="Visible"/>
                        <TextBox x:Name="TxtPasswordVisible" Height="25" Width="405" VerticalContentAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />

                        <ToggleButton x:Name="btnShowPassword" Grid.Column="1" Content="👁"  Margin="5 0 0 0" Height="25"
                                      Checked="BtnShowPassword_Checked" Unchecked="BtnShowPassword_Unchecked" />
                    </Grid>

                    <TextBlock Text="Protection against automated logins" HorizontalAlignment="Center" FontSize="12" Foreground="Gray" Margin="0 10 0 5"/>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0 0 0 10">
                        <StackPanel>
                            <TextBlock Text="Math Captcha:" FontSize="12" Foreground="Gray" Margin="0 0 0 5"/>
                            <TextBlock x:Name="CaptchaQuestionTxt" FontSize="14" FontWeight="Bold" Foreground="DarkBlue" Margin="0 0 0 5"/>
                            <TextBox x:Name="CaptchaInputTxt" Height="25" Width="425" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0 0 0 10">
                        <StackPanel>
                            <TextBlock Text="Emoji Captcha:" FontSize="12" Foreground="Gray" Margin="0 0 0 5"/>
                            <TextBlock x:Name="EmojiCaptchaQuestionTxt" FontSize="14" FontWeight="Bold" Foreground="DarkGreen" TextWrapping="Wrap" Margin="0 0 0 5"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EmojiCaptchaInputTxt" Grid.Column="0" Height="25" Width="425" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshCaptchaBtn" Content="🔄 New Captcha" Height="25" 
            Margin="60 5 60 0" Background="LightGray" Click="RefreshCaptcha_Click"/>

                    <Button x:Name="LoginBtn" Content="Login" Margin="60 15 60 10" IsDefault="True" Height="25"/>

                    <TextBlock x:Name="lblError" Foreground="{DynamicResource RedColor}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>