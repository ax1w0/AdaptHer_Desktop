<Page x:Class="AdaptHER.UI.Pages.AdaptProgramsPg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdaptHER.UI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      
      Title="ConstructorPg" Background="Transparent" FontFamily="Poppins">

    <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Margin="15 5" FontWeight="Bold" Foreground="{DynamicResource TextFourthColor}" FontSize="22">Creating an adaptation program</TextBlock>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 15">
                        <TextBlock VerticalAlignment="Center" Margin="0 0 15 0" 
                            Text="Select trainee:"/>
                        <TextBox x:Name="newEmployeeSearch" Width="180" 
                            VerticalContentAlignment="Center" x:FieldModifier="public"/>
                    </StackPanel>

                    <ComboBox Grid.Row="1" x:Name="selectEmploy" Height="25" x:FieldModifier="public"/>

                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,10">
                        <TextBlock Text="Select department for employment:" Margin="0,10,0,5"/>
                        <ComboBox x:Name="selectGroup" x:FieldModifier="public" Height="25"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Vertical">
                        <TextBlock Text="Select position:" Margin="0,0,0,5"/>
                        <ComboBox x:Name="selectJob" x:FieldModifier="public" Height="25"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Text="Select module(s):" Margin="0,10,0,5"/>

                    <Border Grid.Row="5" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource PrimaryHomingColor}" Background="White">
                        <ListView x:Name="selectModules" x:FieldModifier="public" SelectionMode="Multiple" ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListView.Template>
                                <ControlTemplate TargetType="{x:Type ListView}">
                                    <ScrollViewer Margin="5">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListView.Template>
                        </ListView>
                    </Border>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 15">
                        <TextBlock VerticalAlignment="Center" Margin="0 0 15 0" 
                                  Text="Choose a mentor(s):"/>
                        <TextBox x:Name="mentorsSearch" Width="160" 
                                VerticalContentAlignment="Center" x:FieldModifier="public"/>
                    </StackPanel>

                    <Border Grid.Row="1" CornerRadius="8" BorderThickness="2" 
                            BorderBrush="{DynamicResource PrimaryHomingColor}" 
                            Background="White">
                        <ListView x:Name="selectTeach" x:FieldModifier="public" SelectionMode="Multiple" ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListView.Template>
                                <ControlTemplate TargetType="{x:Type ListView}">
                                    <ScrollViewer Margin="5">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListView.Template>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Button Content="To formulate a program" Margin="0 15 0 0" x:Name="FormProg" x:FieldModifier="public" Click="FormProg_ClickBtn" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Border>
</Page>