<Page x:Class="AdaptHER.UI.Pages.EventsAnalysisPg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdaptHER.UI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EventsAnalysisPg" Background="Transparent" FontFamily="Poppins">

    <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Margin="15 5" FontWeight="Bold" Foreground="{DynamicResource TextFourthColor}" FontSize="22">Adaptation Activity Analysis</TextBlock>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock Margin="0">Select report type:</TextBlock>
                    <ComboBox x:Name="view" x:FieldModifier="public" Margin="0 20 0 15">
                        <TextBlock>Chart</TextBlock>
                        <TextBlock>Diagram</TextBlock>
                    </ComboBox>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock Margin="15 0">Sort by department:</TextBlock>
                    <ComboBox x:Name="selectGroup" x:FieldModifier="public"  Margin="15 20 0 15"/>
                </Grid>

                <Grid Grid.Column="2">
                    <TextBlock Margin="15 0">Sort by position:</TextBlock>
                    <ComboBox x:Name="selectJob" x:FieldModifier="public" Margin="15 20 0 15"/>
                </Grid>

            </Grid>
            <Grid Grid.Row="2">
                <Border CornerRadius="8" Background="{DynamicResource WhiteColor}">
                    <Grid x:Name="contentGrid" x:FieldModifier="public"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0 15 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnPrint" Content="Send to Print" HorizontalAlignment="Stretch" Click="BtnPrint_Click"  Grid.Column="0"/>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <TextBlock Margin="15 0 15 5" Text="Save as:"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnExportPDF" Content="PDF" Width="70" Height="25" Margin="15 0 15 0" Click="BtnExportPDF_Click"/>
                        <Button x:Name="btnExportCSV" Content="CSV" Width="70" Height="25" Click="BtnExportCSV_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
