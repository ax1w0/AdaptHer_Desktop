<Page x:Class="AdaptHER.UI.Pages.AdaptModulesPg"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:uc="clr-namespace:AdaptHER.UI.UC"
      xmlns:local="clr-namespace:AdaptHER.UI.Pages"
      mc:Ignorable="d" x:Name="AdaptPg"
      d:DesignHeight="450" d:DesignWidth="800"
           Title="AdaptModulesPg" Background="Transparent" FontFamily="Poppins">

    <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Margin="15 5" FontWeight="Bold" Foreground="{DynamicResource TextFourthColor}" FontSize="22">Adaptation modules</TextBlock>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock >Job search:</TextBlock>
                    <ComboBox x:Name="selectJob" x:FieldModifier="public" Margin="0 20 0 15">
                        <ComboBoxItem Padding="2" Content="Default"  IsSelected="True"/>
                        <ComboBoxItem Padding="2" Content="Editable"/>
                        <ComboBoxItem Padding="2" Content="Disabled" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Column="1">
                    <TextBlock Margin="15 0">Search by name:</TextBlock>
                    <TextBox x:Name="nameFilter" x:FieldModifier="public" Margin="15 20 0 15" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>

            <Border CornerRadius="8" Background="{DynamicResource SecundaryBackgroundColor}" Grid.Row="2">
                <ScrollViewer Margin="15">
                    <StackPanel x:Name="modulesContainer" x:FieldModifier="public" Margin="0 0 15 0">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type uc:ModuleView}">
                                <Setter Property="Margin" Value="0 0 0 15"/>
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Button x:Name="createButton" x:FieldModifier="public" Content="Create a task for the module development" Grid.Row="3" Margin="0 15 0 0"/>
        </Grid>
    </Border>
</Page>